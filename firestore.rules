rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && getUserRole() in ['admin', 'moderator'];
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────
    // app_config & Public Content
    // ─────────────────────────────────────────

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isActiveOrMissing() {
      return resource.data.isActive == true
          || !(resource.data.keys().hasAny(['isActive']));
    }

    match /news_ticker_items/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /pro_insight/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /know_your_client/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /quizzes/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /home_pro_card/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────
    // users/{uid}  --> (Phase 1 Fix: Corrected Logic)
    // ─────────────────────────────────────────

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      
      allow create: if isOwner(uid) 
                    && request.resource.data.role == 'user' 
                    && request.resource.data.isBlocked == false;
      
      allow update: if isAdmin()
                    || (isOwner(uid) && onlyAllowedUserFields())
                    || (isOwner(uid) && canUpdatePointsSafely());
      
      allow delete: if isAdmin();
    }

    function onlyAllowedUserFields() {
      let allowedFields = ['name', 'avatarIndex'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ✅ الدالة المصححة (Logic & Syntax Fix)
    function canUpdatePointsSafely() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      // 1. منطق التصفير (Reset Logic)
      // الشرط: التغيير في العدادات فقط + أي عداد تم تغييره يجب أن يكون 0
      let isResetUpdate = changed.hasOnly(['dailyStarsRounds', 'dailyProsRounds', 'dailyFreePlayRounds']);
      
      let resetValuesValid = 
           (!('dailyStarsRounds' in changed) || request.resource.data.dailyStarsRounds == 0)
        && (!('dailyProsRounds' in changed) || request.resource.data.dailyProsRounds == 0)
        && (!('dailyFreePlayRounds' in changed) || request.resource.data.dailyFreePlayRounds == 0);

      // 2. منطق تحديث النقاط (Points Update Logic)
      let pointsAllowed = [
        'points', 'starsPoints', 'proPoints',
        'lastQuizDate', 'updatedAt',
        'dailyStarsRounds', 'dailyProsRounds',
        'dailyFreePlayRounds'
      ];
      
      let hasQuizMarker = request.resource.data.lastQuizDate != null;
      let onlyPointsChanged = changed.hasOnly(pointsAllowed);
      
      let safePoints =
           (!('points' in changed) || request.resource.data.points >= resource.data.points)
        && (!('starsPoints' in changed) || request.resource.data.starsPoints >= resource.data.starsPoints)
        && (!('proPoints' in changed) || request.resource.data.proPoints >= resource.data.proPoints);

      let noProfileChange = !('name' in changed) && !('avatarIndex' in changed);

      let isPointsUpdate = hasQuizMarker && onlyPointsChanged && safePoints && noProfileChange;

      // ✅ النتيجة النهائية: إما تصفير صحيح أو تحديث نقاط صحيح
      return (isResetUpdate && resetValuesValid) || isPointsUpdate;
    }

    // ─────────────────────────────────────────
    // user_stats/{uid}
    // ─────────────────────────────────────────

    function simpleUserStatsValidation() {
      let d = request.resource.data;
      
      // 1. التحقق الهيكلي (Strict Top-Level)
      let structureValid = (d is map)
          && d.keys().hasOnly(['stars', 'pros', 'freeplay', 'updatedAt']);
      
      // 2. التحقق الزمني (Server Timestamp)
      let timestampValid = ('updatedAt' in d) && (d.updatedAt == request.time);

      return structureValid && timestampValid;
    }

    match /user_stats/{uid} {
      allow read: if isModerator() || isOwner(uid);
      allow create, update: if isOwner(uid) && simpleUserStatsValidation();
      allow delete: if false;
    }

    // ─────────────────────────────────────────
    // Support & Leaderboards
    // ─────────────────────────────────────────

    match /support_tickets/{ticketId} {
      allow read: if isModerator() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isModerator();
      
      match /messages/{messageId} {
        allow read, create, update, delete: if isModerator() || (isAuthenticated() && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid);
      }
    }

    function isTicketOwner(ticketId) {
      return get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid;
    }

    match /support_chats/{docId} { allow read, write: if isModerator(); }
    match /leaderboards/{league}/entries/{uid} { allow read: if true; allow write: if isModerator(); }
    
    match /{document=**} { allow read, write: if false; }
  }
}