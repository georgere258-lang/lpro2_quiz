rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && getUserRole() in ['admin', 'moderator'];
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────
    // app_config
    // ─────────────────────────────────────────

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // Public Content
    // ─────────────────────────────────────────

    function isActiveOrMissing() {
      return resource.data.isActive == true
          || !(resource.data.keys().hasAny(['isActive']));
    }

    match /news_ticker_items/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /pro_insight/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /know_your_client/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /quizzes/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /home_pro_card/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────
    // users/{uid}
    // ─────────────────────────────────────────

    match /users/{uid} {

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.role == 'user'
                    && request.resource.data.isBlocked == false;

      allow update: if isAdmin()
                    || (isOwner(uid) && onlyAllowedUserFields())
                    || (isOwner(uid) && canUpdatePointsSafely());

      allow delete: if isAdmin();
    }

    function onlyAllowedUserFields() {
  // ✅ نخليها متوافقة مع النظام الحالي
  let allowedFields = ['name', 'avatarIndex'];
  let changedFields = request.resource.data.diff(resource.data).affectedKeys();
  return changedFields.hasOnly(allowedFields);
}

    // ✅ الدالة اللي كانت ناقصة (سبب الخطأ)
    function canUpdatePointsSafely() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      let allowed = [
        'points',
        'starsPoints',
        'proPoints',
        'lastQuizDate',
        'updatedAt',
        'dailyStarsRounds',
        'dailyProsRounds'
      ];

      // لازم يكون تحديث كويز
      let hasQuizMarker = request.resource.data.lastQuizDate != null;

      // ما يغيرش غير حقول النقاط
      let onlyPoints = changed.hasOnly(allowed);

      // زيادة فقط (مش تقليل)
      let safePoints =
        (!('points' in changed) || request.resource.data.points >= resource.data.points)
        && (!('starsPoints' in changed) || request.resource.data.starsPoints >= resource.data.starsPoints)
        && (!('proPoints' in changed) || request.resource.data.proPoints >= resource.data.proPoints);

      // ممنوع يغير الاسم أو الأفاتار مع النقاط
      let noProfileChange =
        !('name' in changed) && !('avatarId' in changed);

      return hasQuizMarker && onlyPoints && safePoints && noProfileChange;
    }

    // ─────────────────────────────────────────
    // support_tickets
    // ─────────────────────────────────────────

    match /support_tickets/{ticketId} {

      allow read: if isModerator()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isModerator();

      match /messages/{messageId} {
        allow read: if isModerator()
                    || (isAuthenticated() && isTicketOwner(ticketId));

        allow create: if isModerator()
                      || (isAuthenticated() && isTicketOwner(ticketId));

        allow update, delete: if isModerator();
      }
    }

    function isTicketOwner(ticketId) {
      return get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId
             == request.auth.uid;
    }

    // legacy
    match /support_chats/{docId} {
      allow read, write: if isModerator();
    }

    match /leaderboards/{league}/entries/{uid} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}