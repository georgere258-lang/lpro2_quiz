rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && getUserRole() in ['admin', 'moderator'];
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // app_config: read for all, write for admin only
    // ═══════════════════════════════════════════════════════════════════════

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // news_ticker_items: public read if isActive, moderator full access
    // ═══════════════════════════════════════════════════════════════════════

    match /news_ticker_items/{docId} {
      allow read: if isModerator() || resource.data.isActive == true;
      allow write: if isModerator();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // pro_insight: public read if isActive, moderator full access
    // ═══════════════════════════════════════════════════════════════════════

    match /pro_insight/{docId} {
      allow read: if isModerator() || resource.data.isActive == true;
      allow write: if isModerator();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // know_your_client: public read if isActive, moderator full access
    // ═══════════════════════════════════════════════════════════════════════

    match /know_your_client/{docId} {
      allow read: if isModerator() || resource.data.isActive == true;
      allow write: if isModerator();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // quizzes: public read if isActive, moderator full access
    // ═══════════════════════════════════════════════════════════════════════

    match /quizzes/{docId} {
      allow read: if isModerator() || resource.data.isActive == true;
      allow write: if isModerator();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // home_pro_card: public read, moderator write
    // ═══════════════════════════════════════════════════════════════════════

    match /home_pro_card/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // users/{uid}: owner reads/updates self (limited fields), admin full
    // ═══════════════════════════════════════════════════════════════════════

    match /users/{uid} {
      // Read: owner can read self, admin can read anyone
      allow read: if isOwner(uid) || isAdmin();

      // Create: only owner at signup, must set role='user' and isBlocked=false
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'user'
                    && request.resource.data.isBlocked == false;

      // Update: owner can update only allowed fields, admin can update anything
      allow update: if isAdmin()
                    || (isOwner(uid) && onlyAllowedUserFields());

      // Delete: admin only
      allow delete: if isAdmin();
    }

    // Helper: user can only update name and avatarId (strictly)
    function onlyAllowedUserFields() {
      let allowedFields = ['name', 'avatarId'];
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return changedFields.hasOnly(allowedFields);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // support_tickets/{ticketId}: owner or moderator
    // ═══════════════════════════════════════════════════════════════════════

    match /support_tickets/{ticketId} {
      // Read: ticket owner or moderator
      allow read: if isModerator()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Create: authenticated user, must be their own ticket
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Update: moderator only (assign/status changes)
      allow update: if isModerator();

      // Delete: moderator only
      allow delete: if isModerator();

      // ─────────────────────────────────────────────────────────────────────
      // messages subcollection
      // ─────────────────────────────────────────────────────────────────────

      match /messages/{messageId} {
        // Read: ticket owner or moderator
        allow read: if isModerator()
                    || (isAuthenticated() && isTicketOwner(ticketId));

        // Create: ticket owner or moderator
        allow create: if isModerator()
                      || (isAuthenticated() && isTicketOwner(ticketId));

        // Update/Delete: moderator only
        allow update, delete: if isModerator();
      }
    }

    // Helper: check if current user owns the parent ticket
    function isTicketOwner(ticketId) {
      return get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // support_chats (legacy): moderator only
    // ═══════════════════════════════════════════════════════════════════════

    match /support_chats/{docId} {
      allow read, write: if isModerator();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Default Deny: everything else is blocked
    // ═══════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
