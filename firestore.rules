rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && getUserRole() in ['admin', 'moderator'];
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────
    // app_config & Public Content
    // ─────────────────────────────────────────

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isActiveOrMissing() {
      return resource.data.isActive == true
          || !(resource.data.keys().hasAny(['isActive']));
    }

    match /news_ticker_items/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /pro_insight/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /know_your_client/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /quizzes/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /home_pro_card/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────
    // users/{uid}
    // ─────────────────────────────────────────

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // create user doc (new user)
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'user'
                    && request.resource.data.isBlocked == false;

      allow update: if isAdmin()
                    || (isOwner(uid) && onlyAllowedUserFields())
                    || (isOwner(uid) && canUpdatePointsSafely());

      allow delete: if isAdmin();
    }

    function onlyAllowedUserFields() {
      let allowedFields = ['name', 'avatarIndex'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ✅ Expert Fix:
    // - Accepts FieldValue.increment() safely (no numeric comparisons inside rules)
    // - Allows daily counters to increment (including FreePlay)
    // - Allows common “play markers” observed in your user doc to update with the same write
    // - Uses `is number` instead of `is int` for maximum safety
    function canUpdatePointsSafely() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      // ─────────────────────────────────────────
      // 1) Reset Logic: allow zeroing counters + timestamps
      // ─────────────────────────────────────────
      let resetKeys = [
        'dailyStarsRounds', 'dailyProsRounds', 'dailyFreePlayRounds',
        'lastQuizDate', 'updatedAt'
      ];

      let isResetUpdate = changed.hasOnly(resetKeys);

      let resetValuesValid =
           (!changed.hasAny(['dailyStarsRounds'])    || request.resource.data.dailyStarsRounds == 0)
        && (!changed.hasAny(['dailyProsRounds'])     || request.resource.data.dailyProsRounds == 0)
        && (!changed.hasAny(['dailyFreePlayRounds']) || request.resource.data.dailyFreePlayRounds == 0)
        && (!changed.hasAny(['lastQuizDate'])        || request.resource.data.lastQuizDate is timestamp)
        && (!changed.hasAny(['updatedAt'])           || request.resource.data.updatedAt    is timestamp);

      // ─────────────────────────────────────────
      // 2) Game Update: allow points + counters + timestamps (supports increment transforms)
      // ─────────────────────────────────────────
      let gameKeys = [
        // points fields (new + legacy observed)
        'points', 'starsPoints', 'proPoints', 'points_stars',

        // daily counters
        'dailyStarsRounds', 'dailyProsRounds', 'dailyFreePlayRounds',

        // play markers/timestamps
        'lastQuizDate', 'updatedAt',
        'lastQuiz',

        // observed field updated during play
        'category_last_played',

        // optional: if your code updates it with play writes
        'dailyQuestionsCount'
      ];

      let isGameUpdate = changed.hasOnly(gameKeys);

      // ✅ Safe numeric checks (is number) to avoid rejection of doubles/transforms
      let gameValuesValid =
           (!changed.hasAny(['lastQuizDate'])        || request.resource.data.lastQuizDate is timestamp)
        && (!changed.hasAny(['updatedAt'])           || request.resource.data.updatedAt    is timestamp)
        && (!changed.hasAny(['lastQuiz'])            || request.resource.data.lastQuiz     is timestamp)
        && (!changed.hasAny(['dailyStarsRounds'])    || request.resource.data.dailyStarsRounds    is number)
        && (!changed.hasAny(['dailyProsRounds'])     || request.resource.data.dailyProsRounds     is number)
        && (!changed.hasAny(['dailyFreePlayRounds']) || request.resource.data.dailyFreePlayRounds is number)
        && (!changed.hasAny(['dailyQuestionsCount']) || request.resource.data.dailyQuestionsCount is number);

      // block profile edits mixed with game writes
      let noProfileChange = !changed.hasAny(['name']) && !changed.hasAny(['avatarIndex']);

      return (isResetUpdate && resetValuesValid)
          || (isGameUpdate && gameValuesValid && noProfileChange);
    }

    // ─────────────────────────────────────────
    // user_stats/{uid}
    // ─────────────────────────────────────────

    function simpleUserStatsValidation() {
      let d = request.resource.data;

      // Strict top-level shape only
      let structureValid = (d is map)
          && d.keys().hasOnly(['stars', 'pros', 'freeplay', 'updatedAt']);

      // ✅ Accepted logic: updatedAt matches the concrete timestamp sent from Repo
      let timestampValid = ('updatedAt' in d) && (d.updatedAt is timestamp);

      return structureValid && timestampValid;
    }

    match /user_stats/{uid} {
      allow read: if isModerator() || isOwner(uid);
      allow create, update: if isOwner(uid) && simpleUserStatsValidation();
      allow delete: if false;
    }

    // ─────────────────────────────────────────
    // Support & Leaderboards
    // ─────────────────────────────────────────

    match /support_tickets/{ticketId} {
      allow read: if isModerator() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isModerator();

      match /messages/{messageId} {
        allow read, create, update, delete: if isModerator()
          || (isAuthenticated() && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid);
      }
    }

    match /support_chats/{docId} {
      allow read, write: if isModerator();
    }

    match /leaderboards/{league}/entries/{uid} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}