rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return isAuthenticated()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && (getUserRole() in ['admin', 'moderator']);
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────
    // app_config & Public Content
    // ─────────────────────────────────────────

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isActiveOrMissing() {
      return resource == null
        || resource.data.isActive == true
        || !(resource.data.keys().hasAny(['isActive']));
    }

    match /news_ticker_items/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /pro_insight/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /know_your_client/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /quizzes/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /home_pro_card/{docId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────
    // Money & Market Radar
    // ─────────────────────────────────────────

    match /money/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    match /market_radar/{docId} {
      allow read: if isModerator() || isActiveOrMissing();
      allow write: if isModerator();
    }

    // ─────────────────────────────────────────
    // users/{uid}
    // ─────────────────────────────────────────

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.isBlocked == false;

      allow update: if isAdmin()
        || (isOwner(uid) && onlyAllowedUserFields())
        || (isOwner(uid) && canUpdatePointsSafely());

      allow delete: if isAdmin();
    }

    function onlyAllowedUserFields() {
      let allowedFields = ['name', 'avatarIndex'];
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(allowedFields);
    }

    function canUpdatePointsSafely() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      let resetKeys = [
        'dailyStarsRounds', 'dailyProsRounds', 'dailyFreePlayRounds',
        'lastQuizDate', 'updatedAt'
      ];

      let isResetUpdate = changed.hasOnly(resetKeys);

      let resetValuesValid =
           (!changed.hasAny(['dailyStarsRounds'])    || request.resource.data.dailyStarsRounds == 0)
        && (!changed.hasAny(['dailyProsRounds'])     || request.resource.data.dailyProsRounds == 0)
        && (!changed.hasAny(['dailyFreePlayRounds']) || request.resource.data.dailyFreePlayRounds == 0)
        && (!changed.hasAny(['lastQuizDate'])        || request.resource.data.lastQuizDate is timestamp)
        && (!changed.hasAny(['updatedAt'])           || request.resource.data.updatedAt is timestamp);

      let gameKeys = [
        'points', 'starsPoints', 'proPoints', 'points_stars',
        'dailyStarsRounds', 'dailyProsRounds', 'dailyFreePlayRounds',
        'lastQuizDate', 'updatedAt',
        'lastQuiz',
        'category_last_played',
        'dailyQuestionsCount'
      ];

      let isGameUpdate = changed.hasOnly(gameKeys);

      let gameValuesValid =
           (!changed.hasAny(['lastQuizDate'])        || request.resource.data.lastQuizDate is timestamp)
        && (!changed.hasAny(['updatedAt'])           || request.resource.data.updatedAt is timestamp)
        && (!changed.hasAny(['lastQuiz'])            || request.resource.data.lastQuiz is timestamp)
        && (!changed.hasAny(['dailyStarsRounds'])    || request.resource.data.dailyStarsRounds is number)
        && (!changed.hasAny(['dailyProsRounds'])     || request.resource.data.dailyProsRounds is number)
        && (!changed.hasAny(['dailyFreePlayRounds']) || request.resource.data.dailyFreePlayRounds is number)
        && (!changed.hasAny(['dailyQuestionsCount']) || request.resource.data.dailyQuestionsCount is number);

      let noProfileChange =
        !changed.hasAny(['name']) && !changed.hasAny(['avatarIndex']);

      return (isResetUpdate && resetValuesValid)
          || (isGameUpdate && gameValuesValid && noProfileChange);
    }

    // ─────────────────────────────────────────
    // user_stats/{uid}
    // ─────────────────────────────────────────

    function simpleUserStatsValidation() {
      let d = request.resource.data;
      return (d is map)
        && d.keys().hasOnly(['stars', 'pros', 'freeplay', 'updatedAt'])
        && ('updatedAt' in d)
        && (d.updatedAt is timestamp);
    }

    match /user_stats/{uid} {
      allow read: if isModerator() || isOwner(uid);
      allow create, update: if isOwner(uid) && simpleUserStatsValidation();
      allow delete: if false;
    }

    // ─────────────────────────────────────────
    // ✅ Support System (HARDENED)
    // ─────────────────────────────────────────

    function ticketOwnerByResource() {
      return isAuthenticated()
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    function ticketOwnerByGet(ticketId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid;
    }

    // (OPTIONAL but recommended) allow owner to bump ticket list fields only
    // This prevents failing when client updates lastMessage/updatedAt on every new message.
    function isSafeTicketOwnerUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let allowed = ['lastMessage', 'updatedAt'];

      let ownerStillSame =
        (request.resource.data.userId == resource.data.userId);

      let lastMsgOk =
        (!changed.hasAny(['lastMessage'])) || (request.resource.data.lastMessage is string);

      let updatedAtOk =
        (!changed.hasAny(['updatedAt'])) || (request.resource.data.updatedAt is timestamp);

      return ticketOwnerByResource()
        && changed.hasOnly(allowed)
        && ownerStillSame
        && lastMsgOk
        && updatedAtOk;
    }

    match /support_tickets/{ticketId} {

      // read: mod OR owner
      allow read: if isModerator() || ticketOwnerByResource();

      // create: user creates own ticket
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // update/delete:
      // - mods: full
      // - owner: only bump fields (lastMessage/updatedAt)
      allow update: if isModerator() || isSafeTicketOwnerUpdate();
      allow delete: if isModerator();

      match /messages/{messageId} {

        // read: mod OR owner
        allow read: if isModerator() || ticketOwnerByGet(ticketId);

        // create: mod OR owner, with strict payload validation
        allow create: if isAuthenticated()
          && (isModerator() || ticketOwnerByGet(ticketId))
          && request.resource.data.keys().hasOnly(['senderId','isAdminMessage','text','sentAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.isAdminMessage is bool
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt is timestamp;

        // messages are immutable for users
        allow update, delete: if isModerator();
      }
    }

    // ─────────────────────────────────────────
    // Leaderboards
    // ─────────────────────────────────────────

    match /leaderboards/{league}/entries/{uid} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}